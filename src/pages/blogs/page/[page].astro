---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Blog from "layouts/blog.astro";
import BlogItem from "layouts/partials/blog-item.astro";

const { page } = Astro.props;

export const getStaticPaths = (async ({ paginate }) => {
  const blogs = (await getCollection("blogs")).sort(
    (a, b) => b.data["createdAt"].getTime() - a.data["createdAt"].getTime(),
  );

  return paginate(
    blogs.map((a) => {
      return {
        params: {
          slug: a.slug,
        },
        props: a,
      };
    }),
    {
      pageSize: 9,
    },
  );
}) satisfies GetStaticPaths;
---

<Blog doc={{ title: "Blogs" }}>
  <h1 class="uk-h1">Blogs</h1>

  <p class="uk-text-lead uk-paragraph">
    Welcome to my personal space. Thoughts and opinions are mine.
  </p>

  <hr class="uk-divider-icon uk-margin-medium" />

  {
    page.data.length >= 1 ? (
      <>
        <div class="uk-child-width-1-2@s" uk-grid="masonry: pack">
          {page.data.map((a) => (
            <BlogItem blog={a.props} />
          ))}
        </div>

        <nav class="uk-margin-medium">
          <ul class="uk-pagination">
            {page.url.prev ? (
              <li>
                <a class="uk-padding-small" href={page.url.prev}>
                  <span class="uk-margin-small-right" uk-pagination-previous />
                  Previous
                </a>
              </li>
            ) : (
              ""
            )}

            {page.url.next ? (
              <li class="uk-margin-auto-left">
                <a class="uk-padding-small" href={page.url.next}>
                  Next <span class="uk-margin-small-left" uk-pagination-next />
                </a>
              </li>
            ) : (
              ""
            )}
          </ul>
        </nav>
      </>
    ) : (
      ""
    )
  }
</Blog>
