---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Master from "layouts/master.astro";
import Carbon from "layouts/partials/carbon.astro";
import examples from "layouts/partials/examples";

const docs = await getCollection("docs");

export const getStaticPaths = (async () => {
  const docs = await getCollection("docs");

  return docs.map((a) => {
    return {
      params: {
        slug: a.slug,
      },
      props: a,
    };
  });
}) satisfies GetStaticPaths;

const entry = Astro.props;

const { Content, headings, remarkPluginFrontmatter } = await entry.render();

const titleCase = function (string: string) {
  return string
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
};
---

<Master
  doc={{
    title: remarkPluginFrontmatter.title,
    meta: remarkPluginFrontmatter.meta,
  }}
>
  <div class="min-h-screen xl:mx-auto xl:max-w-8xl" id="app">
    <aside class="aside-l">
      <ul class="uk-iconnav uk-iconnav-outline">
        <li>
          <a class="cursor-pointer" href="#theme" uk-toggle>
            <uk-icon icon="palette"></uk-icon>
          </a>
        </li>
        <li class="ml-auto lg:hidden">
          <a
            class="cursor-pointer"
            x-data
            x-on:click="document.getElementById('app')?.classList.remove('with-aside')"
          >
            <uk-icon icon="x"></uk-icon>
          </a>
        </li>
      </ul>

      <div class="mt-4">
        <a class="search group" uk-toggle="#search">
          <div class="flex flex-1 items-center">
            <span class="mr-2 size-4">
              <uk-icon icon="search"></uk-icon>
            </span>
            <span>Search</span>
          </div>
          <kbd
            class="group-hover:border-accent-foreground/10 group-hover:text-accent-foreground"
          >
            ⌘ /
          </kbd>
        </a>
        <uk-command key="/" toggle="search">
          <select hidden>
            {
              docs.map((collection) => (
                <option
                  data-group={titleCase(collection.data.group)}
                  data-keywords={collection.data.keywords}
                >
                  {collection.data.text}
                </option>
              ))
            }
          </select>
        </uk-command>
      </div>

      <div class="mt-1">
        <ul
          class="uk-nav uk-nav-default -mx-1 mt-1"
          uk-nav="collapsible: false"
        >
          <li class="uk-parent">
            <a href="#">
              Examples <span uk-nav-parent-icon></span>
            </a>
            <ul class="uk-nav-sub" hidden>
              {
                examples.map((a) => (
                  <li>
                    <a href={`/examples/${a.slug}`}>{a.title}</a>
                  </li>
                ))
              }
            </ul>
          </li>
          {
            ["prologue", "getting-started", "components"].map((z) => (
              <li
                class={`uk-parent ${entry.data.group === z ? "uk-open" : ""}`}
              >
                <a href="#">
                  {titleCase(z)} <span uk-nav-parent-icon />
                </a>
                <ul class="uk-nav-sub" hidden={entry.data.group !== z}>
                  {docs
                    .filter((a) => a.data.group === z)
                    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
                    .map((collection) => (
                      <li
                        class={` ${entry.slug === collection.slug ? "uk-active" : ""}`}
                      >
                        <a
                          class="flex items-center justify-between"
                          href={`/docs/${collection.slug}`}
                        >
                          <span class="flex-1">{collection.data.text}</span>
                          {collection.data.ping === true ? (
                            <span class="relative flex h-2 w-2 flex-none">
                              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary/75" />
                              <span class="relative inline-flex h-2 w-2 rounded-full bg-primary" />
                            </span>
                          ) : (
                            ""
                          )}
                        </a>
                        {collection.data.submenu ? (
                          <ul>
                            {collection.data.submenu.map((b) => (
                              <li>
                                <a
                                  class="flex items-center justify-between"
                                  href={b.href}
                                  target={b.target || "_self"}
                                >
                                  <span class="flex-1">{b.text}</span>
                                  {b.href.startsWith("http") ? (
                                    <uk-icon icon="external-link" />
                                  ) : (
                                    ""
                                  )}
                                </a>
                              </li>
                            ))}
                          </ul>
                        ) : (
                          ""
                        )}
                      </li>
                    ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>

    <main class="main">
      <div class="topbar">
        <div class="flex flex-1 items-center justify-between xl:pr-56">
          <button
            class="uk-icon-button uk-icon-button-outline lg:hidden"
            x-data
            x-on:click="document.getElementById('app')?.classList.add('with-aside')"
          >
            <uk-icon icon="menu"></uk-icon>
          </button>
        </div>
      </div>

      <div class="content" id="content">
        <div class="content-wrapper">
          <h1 class="uk-h1">
            {entry.data.title}
          </h1>

          {
            entry.data.lead ? (
              <p class="uk-text-lead uk-paragraph">{entry.data.lead}</p>
            ) : (
              ""
            )
          }

          {
            entry.data.wip === true ? (
              <div class="uk-alert-warning uk-alert mt-6">
                This documentation is a work in progress.
              </div>
            ) : (
              <div class="ads">
                <Carbon format="responsive" />
              </div>
            )
          }

          <Content />
        </div>

        <div class="hidden w-56 xl:block">
          <div class="space-y-6 pt-10" uk-sticky>
            {
              headings.length > 0 ? (
                <ul
                  class="uk-nav uk-nav-default"
                  uk-scrollspy-nav="closest: li; scroll: true; offset: 40"
                >
                  <li class="uk-nav-header">On This Page</li>
                  {headings
                    .filter((a) => a.depth === 2)
                    .map((a) => (
                      <li>
                        <a href={`#${a.slug}`}>{a.text}</a>
                      </li>
                    ))}
                </ul>
              ) : (
                ""
              )
            }
          </div>
        </div>
      </div>
    </main>

    <div
      class="backdrop cursor-pointer"
      id="backdrop"
      role="button"
      tabindex="0"
      x-data
      x-on:click="document.getElementById('app')?.classList.remove('with-aside')"
    >
    </div>

    <div class="uk-modal" id="theme" uk-modal>
      <div class="uk-modal-dialog">
        <button class="uk-modal-close-default" type="button" uk-close></button>
        <div class="uk-modal-header">
          <div class="uk-modal-title">Customize</div>
        </div>
        <div class="uk-modal-body">
          <uk-theme-switcher></uk-theme-switcher>
        </div>
      </div>
    </div>
  </div>

  <iframe
    name="ls"
    class="hidden"
    width="0"
    height="0"
    src={`${import.meta.env.EXAMPLES_URL}/ls`}></iframe>

  <script is:inline>
    window.addEventListener("resize", () => {
      document.getElementById("app")?.classList.remove("with-aside");
    });

    const asideL = document.querySelector(".aside-l");

    const navSub = asideL.querySelector("li.uk-parent.uk-open");
    const focused = navSub.querySelector("li.uk-active");

    const rects = {
      asideL: asideL.getBoundingClientRect(),
      focused: focused.getBoundingClientRect(),
    };

    const scrollTop =
      focused.offsetTop -
      asideL.offsetTop -
      rects.asideL.height / 2 +
      rects.focused.height / 2;

    asideL.scrollTo({
      top: scrollTop,
      behavior: "smooth",
    });

    const content = document.getElementById("content");

    content.addEventListener("click", function (event) {
      if (event.target.classList.contains("c")) {
        let target = event.target.closest("div");

        if (target) {
          const code = target.querySelector("code");

          if (code) {
            navigator.clipboard
              .writeText(code.textContent)
              .then(() => {
                UIkit.notification({
                  message: "Copied to clipboard",
                  pos: "bottom-right",
                });
              })
              .catch(() => {});
          }
        }
      }
    });

    const iframe = window.frames["ls"];

    const observer = new MutationObserver(() => {
      if (htmlElement.classList.contains("dark")) {
        iframe.postMessage({ dark: true }, "*");
      } else {
        iframe.postMessage({ dark: false }, "*");
      }

      const theme = Array.from(htmlElement.classList).find((cls) =>
        cls.startsWith("uk-theme-"),
      );

      if (theme) {
        iframe.postMessage({ theme: theme }, "*");
      }
    });

    observer.observe(htmlElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  </script>
</Master>
