---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Master from "layouts/master.astro";

const docs = await getCollection("docs");

export const getStaticPaths = (async () => {
  const docs = await getCollection("docs");

  return docs.map((a) => {
    return {
      params: {
        slug: a.slug,
      },
      props: a,
    };
  });
}) satisfies GetStaticPaths;

const entry = Astro.props;

const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const { pathname } = Astro.url;
---

<Master
  doc={{
    title: remarkPluginFrontmatter.title,
    meta: remarkPluginFrontmatter.meta,
  }}
>
  <div class="xl:max-w-8xl min-h-screen xl:mx-auto" id="app">
    <aside class="aside-l">
      <button
        class="uk-icon-button uk-icon-button-xsmall uk-icon-button-outline absolute right-4 top-4 lg:hidden"
        id="bars-close"
        x-data
        x-on:click="document.getElementById('app')?.classList.remove('with-aside')"
      >
        <svg
          class="h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          fill="currentColor"
        >
          <path
            d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z"
          ></path>
        </svg>
      </button>

      <div class="pt-6"></div>

      <ul
        class="uk-nav uk-nav-default"
        uk-nav="multiple: true; collapsible: false"
      >
        <li class="uk-nav-header">Documentation</li>
        {
          ["getting-started", "components", "web-components"].map((z) => (
            <li class={`uk-parent ${entry.data.group === z ? "uk-open" : ""}`}>
              <a href="#">
                {z
                  .split("-")
                  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
                  .join(" ")}
                <span uk-nav-parent-icon />
              </a>
              <ul class="uk-nav-sub">
                {docs
                  .filter((a) => a.data.group === z)
                  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
                  .map((collection) => (
                    <li
                      class={`flex items-center justify-between ${pathname.replace("/docs/", "") === collection.slug ? "uk-active" : ""}`}
                    >
                      <a
                        class="flex-1 gap-x-2"
                        href={`/docs/${collection.slug}`}
                      >
                        {collection.data.text}
                      </a>
                      {collection.data.ping === true ? (
                        <span class="relative flex h-2 w-2">
                          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary/75" />
                          <span class="relative inline-flex h-2 w-2 rounded-full bg-primary" />
                        </span>
                      ) : (
                        ""
                      )}
                    </li>
                  ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </aside>

    <main class="main">
      <div class="topbar">
        <div class="flex flex-1 flex-wrap items-center justify-between">
          <button
            class="uk-icon-button uk-icon-button-xsmall uk-icon-button-outline lg:hidden"
            x-data
            x-on:click="document.getElementById('app')?.classList.add('with-aside')"
          >
            <svg
              class="h-4 w-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M2 4.75A.75.75 0 0 1 2.75 4h10.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 6.5a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z"
                clip-rule="evenodd"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="xl:flex">
        <div class="px-4 pt-8 lg:px-6 lg:pt-12">
          <Content />
        </div>

        <div class="hidden w-56 flex-none xl:block">
          <ul
            class="uk-nav uk-nav-default"
            uk-scrollspy-nav="closest: li; scroll: true; offset: 40"
            uk-sticky="offset: 32"
          >
            <li class="uk-nav-header">On This Page</li>
            {
              headings
                .filter((a) => a.depth === 2)
                .map((a) => (
                  <li>
                    <a href={`#${a.slug}`}>{a.text}</a>
                  </li>
                ))
            }
          </ul>
        </div>
      </div>
    </main>

    <div
      class="backdrop cursor-pointer"
      id="backdrop"
      role="button"
      tabindex="0"
      x-data
      x-on:click="document.getElementById('app')?.classList.remove('with-aside')"
    >
    </div>
  </div>

  <script is:inline>
    window.addEventListener("resize", () => {
      document.getElementById("app")?.classList.remove("with-aside");
    });
  </script>
</Master>

