---
import Main from "layouts/main.astro";
import Announcement from "layouts/partials/announcement.astro";
import Examples from "layouts/partials/examples.astro";
---

<Main
  doc={{
    title: "Franken UI",
    meta: {
      description:
        "Franken UI is an HTML-first, open-source library of UI components that works as a standalone or as a Tailwind CSS plugin.",
    },
  }}
>
  <div class="grid grid-cols-1 gap-20 py-8 lg:grid-cols-2">
    <div class="space-y-4">
      <Announcement />

      <h1 class="uk-heading-small font-bold">Franken UI</h1>
      <p class="font-light">
        HTML-first, open-source library of UI components that works as a
        standalone or as a Tailwind CSS plugin.
      </p>

      <div class="flex gap-x-2">
        <a
          class="uk-button uk-button-primary uk-button-small"
          href="/docs/introduction"
        >
          Get Started
        </a>
        <a
          class="uk-button uk-button-secondary uk-button-small gap-x-2"
          href="https://github.com/franken-ui/ui"
          target="_blank"
        >
          Star on Github
        </a>
      </div>
    </div>
  </div>

  <Examples active="mail" />
</Main>
