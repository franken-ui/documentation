---
import Main from "layouts/main.astro";
import Announcement from "layouts/partials/announcement.astro";
---

<Main
  doc={{
    title: "Franken UI",
    meta: {
      description:
        "Franken UI is an HTML-first, open-source library of UI components that works as a standalone or as a Tailwind CSS plugin.",
    },
  }}
>
  <div class="mx-auto max-w-7xl">
    <div
      class="flex flex-col items-center gap-2 py-8 md:py-12 md:pb-8 lg:py-24 lg:pb-20"
    >
      <Announcement />

      <h1
        class="text-center text-3xl font-bold leading-tight tracking-tighter md:text-5xl lg:leading-[1.1]"
      >
        Franken UI
      </h1>

      <span class="text-center text-lg font-light text-foreground">
        HTML-first, open-source library of UI components that works as a
        standalone or as a Tailwind CSS plugin.
      </span>

      <div
        class="flex w-full items-center justify-center space-x-4 py-4 md:pb-10"
      >
        <a class="uk-button uk-button-primary" href="/docs/introduction">
          Get Started
        </a>
        <a
          class="uk-button uk-button-secondary gap-x-2"
          href="https://github.com/franken-ui/ui"
          target="_blank"
        >
          Star on Github
        </a>
      </div>

      <div class="hidden lg:block">
        <div class="g g-ob">
          <div class="gc ob">
            <pre
              tabindex="0"
              data-language="sh"><code><span class="line"><span style="color:#FFF;font-weight:bold">npm</span><span style="color:#FFF8"> i</span><span style="color:#FFF8"> tailwindcss</span><span style="color:#FFF8"> postcss</span><span style="color:#FFF8"> franken-ui</span><span style="color:#FFF8"> &amp;&amp;</span><span style="color:#FFF;font-weight:bold"> npx</span><span style="color:#FFF8"> franken-ui</span><span style="color:#FFF8"> init</span><span style="color:#FFF8"> -p</span></span></code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</Main>
