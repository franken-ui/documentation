---
import type { GetStaticPaths } from "astro";
import Main from "layouts/main.astro";
import Announcement from "layouts/partials/announcement.astro";
import Examples from "layouts/partials/examples.astro";

const { slug } = Astro.params;

export const getStaticPaths = (async () => {
  return [
    {
      slug: "mail",
      title: "Mail",
      description:
        "A modern email interface displaying inbox with various folders and messages. This sleek design is powered by HTMX and also available in dark mode.",
      height: "724px",
    },
    {
      slug: "dashboard",
      title: "Dashboard",
      description:
        "A sleek, user-friendly dashboard interface showcasing key business metrics and recent sales data. Use this to build your own dashboard user interfaces.",
      height: "810px",
    },
    {
      slug: "cards",
      title: "Cards",
      description:
        "A modern user interface design featuring login forms, payment method inputs, etc. Use this to build your own.",
      height: "1300px",
    },
    {
      slug: "task",
      title: "Task",
      description:
        "Task management interface displaying a list of technical assignments with priorities and status. This sleek design is ideal for table-heavy user interfaces.",
      height: "786px",
    },
    {
      slug: "playground",
      title: "Playground",
      description:
        "Intuitive interface for text generation, with customizable settings on the right. Useful for building AI-driven creative writing user interfaces.",
      height: "824px",
    },
    {
      slug: "forms",
      title: "Forms",
      description:
        "This sleek form design is perfect for updating of user profile, setting email preferences, and any general user account settings.",
      height: "955px",
    },
    {
      slug: "music",
      title: "Music",
      description:
        "Music features a UI of a music streaming application with sections like Discover, Listen Now and Radio. This type of interface can be useful for a Music or Podcast applications.",
      height: "898px",
    },
    {
      slug: "authentication",
      title: "Authentication",
      description:
        "Authentication is a sleek UI for account creation page. Useful for building authentication pages.",
      height: "800px",
    },
  ].map((a) => {
    return {
      params: {
        slug: a.slug,
      },
      props: a,
    };
  });
}) satisfies GetStaticPaths;

const example = Astro.props;
---

<Main
  doc={{
    title: example.title,
    meta: {
      description: example.description,
    },
  }}
>
  <div class="grid grid-cols-1 gap-20 py-8 lg:grid-cols-2">
    <div class="space-y-4">
      <Announcement />

      <h1 class="uk-heading-small font-bold">{example.title}</h1>
      <p class="font-light">
        {example.description}
      </p>

      <div class="flex gap-x-2">
        <a
          class="uk-button uk-button-primary uk-button-small"
          href="/docs/introduction"
        >
          Get Started
        </a>
        <a
          class="uk-button uk-button-secondary uk-button-small gap-x-2"
          href="https://github.com/franken-ui/examples"
          target="_blank"
        >
          View Source
        </a>
      </div>
    </div>
  </div>

  <Examples active={slug}>
    <iframe
      class="hidden xl:block"
      name={slug}
      src={`https://examples.franken-ui.dev/${slug}`}
      height={`${example.height}`}
      width="100%"></iframe>
  </Examples>
</Main>
