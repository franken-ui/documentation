---
import { Image } from "astro:assets";

const { active } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/*.{jpeg,jpg,png,gif}",
);
const image = (await images[`/src/images/${active}-light.png`]()).default;
---

<div class="mt-10 overflow-hidden">
  <ul
    class="uk-subnav uk-subnav-secondary -mb-10 flex-nowrap overflow-auto pb-10"
  >
    {
      [
        { slug: "mail", text: "Mail" },
        { slug: "dashboard", text: "Dashboard" },
        { slug: "cards", text: "Cards" },
        { slug: "task", text: "Task" },
        { slug: "playground", text: "Playground" },
        { slug: "forms", text: "Forms" },
        { slug: "music", text: "Music" },
        { slug: "authentication", text: "Authentication" },
      ].map((a) => (
        <li class={active === a.slug ? "uk-active" : ""}>
          <a class="h-7" href={`/examples/${a.slug}`}>
            {a.text}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-4 overflow-hidden rounded-lg border border-border shadow-lg">
    <slot />

    <div class="xl:hidden">
      <div class="dark:hidden" uk-lightbox>
        <Image
          alt=""
          sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${image.width}px`}
          src={images[`/src/images/${active}-light.png`]()}
          widths={[240, 540, 720, image.width]}
        />
      </div>

      <div class="hidden dark:block" uk-lightbox>
        <Image
          alt=""
          sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${image.width}px`}
          src={images[`/src/images/${active}-dark.png`]()}
          widths={[240, 540, 720, image.width]}
        />
      </div>
    </div>
  </div>

  <div
    role="alert"
    class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-foreground dark:border-amber-950 dark:bg-amber-950/50 xl:hidden"
  >
    <div class="text-sm [&_p]:leading-relaxed">
      <p class="leading-7 [&:not(:first-child)]:mt-6">
        <strong>Note:</strong> You are viewing a static image preview. Please switch
        to a larger screen to experience the real thing.
      </p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ active }}>
  const htmlElement = document.documentElement;
  const iframe = window.frames[active];

  if (htmlElement.classList.contains("dark")) {
    iframe.postMessage("dark-mode-enabled", "*");
  }

  const observer = new MutationObserver(() => {
    if (htmlElement.classList.contains("dark")) {
      iframe.postMessage("dark-mode-enabled", "*");
    } else {
      iframe.postMessage("dark-mode-disabled", "*");
    }
  });

  observer.observe(htmlElement, {
    attributes: true,
    attributeFilter: ["class"],
  });
</script>
