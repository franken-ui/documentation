---
import { Image } from "astro:assets";
import data from "layouts/partials/examples";

const { active } = Astro.props;

const example = data.find((a) => a.slug === active);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/*.{jpeg,jpg,png,gif}",
);
const image = (await images[`/src/images/${active}-light.png`]()).default;
---

<div class="mt-8">
  <div class="overflow-hidden">
    <ul
      class="uk-subnav uk-subnav-secondary -mb-10 flex-nowrap overflow-x-auto pb-10"
    >
      {
        data.map((a) => (
          <li class={active === a.slug ? "uk-active" : ""}>
            <a class="h-7" href={`/examples/${a.slug}`}>
              {a.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class="mt-4 overflow-hidden rounded-lg border border-border shadow-lg"
    id="example"
  >
    <iframe
      class="hidden xl:block"
      name={active}
      src={`${import.meta.env.EXAMPLES_URL}/examples/${active}`}
      height={`${example?.height}`}
      width="100%"></iframe>

    <div class="xl:hidden">
      <div class="dark:hidden" uk-lightbox>
        <Image
          alt=""
          sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${image.width}px`}
          src={images[`/src/images/${active}-light.png`]()}
          widths={[240, 540, 720, image.width]}
        />
      </div>

      <div class="hidden dark:block" uk-lightbox>
        <Image
          alt=""
          sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${image.width}px`}
          src={images[`/src/images/${active}-dark.png`]()}
          widths={[240, 540, 720, image.width]}
        />
      </div>
    </div>
  </div>

  <div role="alert" class="uk-alert-warning uk-alert mt-4 xl:hidden">
    <div class="text-sm [&_p]:leading-relaxed">
      <p class="leading-7 [&:not(:first-child)]:mt-6">
        <strong>Note:</strong> You are viewing a static image preview. Please switch
        to a larger screen to experience the real thing.
      </p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ active }}>
  const iframe = window.frames[active];

  const observer = new MutationObserver(() => {
    if (htmlElement.classList.contains("dark")) {
      iframe.postMessage({ dark: true }, "*");
    } else {
      iframe.postMessage({ dark: false }, "*");
    }

    const theme = Array.from(htmlElement.classList).find((cls) =>
      cls.startsWith("uk-theme-"),
    );

    if (theme) {
      iframe.postMessage({ theme: theme }, "*");
    }
  });

  observer.observe(htmlElement, {
    attributes: true,
    attributeFilter: ["class"],
  });
</script>
