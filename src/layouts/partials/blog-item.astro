---
const { blog } = Astro.props;
---

<div class="relative space-y-2">
  {
    blog.data.image ? (
      <div class="aspect-video rounded-md border border-border dark:bg-primary">
        <img class="h-full w-full" src={blog.data.image} alt="" />
      </div>
    ) : (
      ""
    )
  }
  <h2 class="uk-h3 font-extrabold">
    <a href={`/blogs/${blog.slug}`}>
      {blog.data.title}
      <span class="absolute inset-0"></span>
    </a>
  </h2>
  <time
    datetime={blog.data.createdAt.toISOString()}
    class="uk-text-muted block text-sm"
  >
    Published on {
      blog.data.createdAt.toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      })
    }
  </time>
</div>
