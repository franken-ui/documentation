---

<header
  uk-sticky="sel-target: .uk-navbar-container; cls-active: uk-navbar-sticky;"
>
  <nav class="uk-navbar-container">
    <div class="uk-container uk-container-xlarge">
      <div class="uk-navbar" uk-navbar="mode: click">
        <div class="uk-navbar-left flex">
          <a class="uk-navbar-item" href="/">
            <img
              width="40"
              height="40"
              src="/images/man_zombie_3d.png"
              alt=""
            />
          </a>
          <ul class="uk-navbar-nav hidden lg:flex">
            <li class={pathname.startsWith("/docs") ? "uk-active" : ""}>
              <a href="/docs/introduction">Docs</a>
            </li>
            <li class={pathname === "/changelog" ? "uk-active" : ""}>
              <a href="/changelog">Changelog</a>
            </li>
            <li class={pathname === "/about" ? "uk-active" : ""}>
              <a href="/about">About</a>
            </li>
            <li class={pathname.startsWith("/examples") ? "uk-active" : ""}>
              <a href="/examples/mail">Examples</a>
            </li>
            <li class={pathname.startsWith("/blogs") ? "uk-active" : ""}>
              <a href="/blogs">Blogs</a>
            </li>
          </ul>
        </div>

        <div class="uk-navbar-right md:flex-none">
          <div class="uk-navbar-item">
            <div class="g g-kf overflow-hidden rounded-md">
              <a class="gc" href="https://ko-fi.com/sveltecult" target="_blank">
                <img
                  class="hidden h-9 dark:block"
                  src="/images/ko-fi-white.png"
                  alt="Support @sveltecult on Ko-Fi"
                />
                <img
                  class="h-9 dark:hidden"
                  src="/images/ko-fi-black.png"
                  alt="Support @sveltecult on Ko-Fi"
                />
              </a>
            </div>
          </div>
          <div class="uk-navbar-item flex">
            <ul class="uk-iconnav flex-none">
              <li>
                <a href="#search" uk-toggle>
                  <span class="sr-only">Search</span>
                  <span class="size-4">
                    <uk-lucide icon="search"></uk-lucide>
                  </span>
                </a>
                <uk-command key="/" toggle="search" uk-cloak>
                  {
                    components.map((a) => (
                      <a
                        data-group={a.group}
                        data-keywords={a.keywords.join(",")}
                        href={a.href}
                      >
                        <span class="mr-2 size-3">
                          <uk-lucide height="12" width="12" icon="circle" />
                        </span>
                        <span>{a.text}</span>
                      </a>
                    ))
                  }
                </uk-command>
              </li>
              <li>
                <a class="cursor-pointer" id="theme-toggle">
                  <span class="sr-only">Toggle light or dark mode</span>
                  <svg
                    id="theme-toggle-light-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-sun dark:hidden"
                  >
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2"></path>
                    <path d="M12 20v2"></path>
                    <path d="m4.93 4.93 1.41 1.41"></path>
                    <path d="m17.66 17.66 1.41 1.41"></path>
                    <path d="M2 12h2"></path>
                    <path d="M20 12h2"></path>
                    <path d="m6.34 17.66-1.41 1.41"></path>
                    <path d="m19.07 4.93-1.41 1.41"></path>
                  </svg>
                  <svg
                    id="theme-toggle-dark-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-moon hidden dark:block"
                  >
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                  </svg>
                </a>
              </li>
              <li class="uk-hidden@xl">
                <a href="#menu" uk-toggle>
                  <span class="sr-only">Toggle menu</span>
                  <span class="size-4">
                    <uk-lucide icon="menu"></uk-lucide>
                  </span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<div id="menu" class="uk-offcanvas" uk-offcanvas="overlay: true;">
  <div class="uk-offcanvas-bar p-6">
    <button class="uk-offcanvas-close right-6 top-6" type="button" uk-close
    ></button>

    <slot name="offcanvas" />
  </div>
</div>
