---
import Master from "./master.astro";
import Carbon from "./partials/carbon.astro";

const { doc } = Astro.props;
---

<Master doc={doc}>
  <div class="flex min-h-screen flex-col" id="app">
    <div class="flex-1">
      <div class="uk-container uk-container-xlarge">
        <div class="grid min-h-40 grid-cols-1 gap-y-8 pt-8 lg:grid-cols-2">
          <div class="space-y-4">
            <h1 class="uk-heading-small font-bold">{doc.title}</h1>
            <p class="font-light">
              {doc.meta.description}
            </p>

            <div class="flex gap-x-1">
              <a
                class="uk-button uk-button-primary uk-button-small"
                href="/docs/introduction"
              >
                Documentation
              </a>
              <a
                class="uk-button uk-button-default uk-button-small gap-x-2"
                href="https://github.com/franken-ui"
                target="_blank"
              >
                Github
              </a>
              <div class="uk-inline">
                <button
                  class="uk-icon-button uk-icon-button-small uk-icon-button-outline"
                >
                  <uk-icon icon="palette" uk-cloak></uk-icon>
                </button>
                <div
                  class="uk-card uk-card-body uk-card-default uk-drop w-96"
                  uk-drop="mode: click; offset: 8"
                >
                  <div class="uk-card-title uk-margin-medium-bottom">
                    Customize
                  </div>
                  <uk-theme-switcher></uk-theme-switcher>
                </div>
              </div>
            </div>
          </div>

          <div class="flex justify-center lg:justify-end">
            <Carbon format="responsive" />
          </div>
        </div>

        <slot />
      </div>
    </div>

    <div class="flex-none">
      <footer class="uk-container uk-container-xlarge py-6">
        <div class="flex flex-col items-center">
          <p
            class="text-balance text-center text-sm leading-loose text-muted-foreground md:text-left"
          >
            Ported by <a
              class="uk-link"
              href="https://x.com/sveltecult"
              target="_blank">sveltecult</a
            >, designed by <a
              class="uk-link"
              href="https://twitter.com/shadcn"
              target="_blank">shadcn</a
            >. The source code is available on <a
              class="uk-link"
              href="https://github.com/franken-ui/ui"
              target="_blank">Github</a
            >.
          </p>
        </div>
      </footer>
    </div>
  </div>
</Master>
